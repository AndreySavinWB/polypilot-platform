# Copy to .env and fill values locally.
# Do not paste real keys into chat.

PORT=8787
# HOST=127.0.0.1   # локально; на Railway/VPS по умолчанию 0.0.0.0
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# --- LLM: Polza.ai (рекомендуется для RU) ---
LLM_PROVIDER=polza
LLM_BASE_URL=https://polza.ai/api/v1/chat/completions
POLZA_API_KEY=pza_...
OPENAI_MODEL=gpt-4o-mini

# --- LLM: OpenAI напрямую (альтернатива) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# OPENAI_API_KEY=sk-...
