# Copy to .env and fill values locally.
# Do not paste real keys into chat.

PORT=8787
# HOST=127.0.0.1   # локально; на Railway/VPS по умолчанию 0.0.0.0
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# --- LLM: Polza.ai (основной провайдер) ---
LLM_PROVIDER=polza
LLM_BASE_URL=https://polza.ai/api/v1/chat/completions
POLZA_API_KEY=pza_...
OPENAI_MODEL=gpt-4o-mini

# --- LLM: OpenRouter (резерв, см. КОГДА_OPENROUTER.md) ---
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_API_KEY=sk-or-v1-...
# LLM_MODEL=openai/gpt-4o-mini

# --- LLM: OpenAI напрямую ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# OPENAI_API_KEY=sk-...

# Harvest
PP_SCAN_LIMIT=300
PP_TOP_N=10

# --- Telegram bot (Funnel 1.0) ---
TELEGRAM_BOT_TOKEN=
# Optional webhook auth header
TELEGRAM_WEBHOOK_SECRET=
# Public backend URL for webhook registration (Railway)
PUBLIC_BACKEND_URL=
PP_SITE_BASE=https://polypilot-platform.vercel.app/app
TELEGRAM_CHANNEL_URL=https://t.me/polypilot_pro
# CEO daily publish reminder (scripts/daily_publish.py)
TELEGRAM_CEO_CHAT_ID=
DAILY_PUBLISH_START_DATE=2026-06-14
